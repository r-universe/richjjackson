[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "chestR"]
	path = chestR
	url = https://github.com/richjjackson/chestr
[submodule "psc"]
	path = psc
	url = https://github.com/richjjackson/psc
[submodule "pscDesign"]
	path = pscDesign
	url = https://github.com/richjjackson/pscdesign
